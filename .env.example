# TripOps configuration.
#
# Copy to .env and fill in. The same file is read by `task` (which exports it
# for every task) and by Docker Compose, so local runs and containers agree.
#
#   cp .env.example .env
#
# Every value here is a plain environment variable, so a container platform can
# set them directly instead.

# =============================================================================
# REQUIRED
# =============================================================================
# Without these the app still starts, but the product does not work: there is
# no bot to talk to and no invite link to share.

# From @BotFather: send /newbot, then copy the token it gives you.
# Leave empty to run the API alone — the bot and all notifications are disabled.
TELEGRAM_BOT_TOKEN=

# The bot's @username, without the @. Invite deep links are built from it
# (https://t.me/<username>?start=inv_<token>), so invitations do not work
# without it.
TELEGRAM_BOT_USERNAME=

# =============================================================================
# REQUIRED IN PRODUCTION
# =============================================================================
# Defaults cover development; production must be explicit.

# development | production
# production refuses every development shortcut, and requires the two values
# below to be set.
APP_ENV=development

# SQLite is the default, and what the deployed stack uses too: one process and
# a trip-sized amount of data do not need a database server.
DATABASE_URL=sqlite://tripops.db
# PostgreSQL is supported and tested if you outgrow that:
#   DATABASE_URL=postgres://tripops:tripops@localhost:5432/tripops?sslmode=disable

# Public HTTPS URL of the Mini App. Also set it in @BotFather
# (/setmenubutton), or the trip has no app to open.
MINIAPP_URL=

# =============================================================================
# REQUIRED FOR WEBHOOK MODE
# =============================================================================
# polling needs no public URL and is the right default for development.
# webhook is what production should use.
TELEGRAM_BOT_MODE=polling

# Public HTTPS base URL of this backend; the path is appended automatically.
TELEGRAM_WEBHOOK_URL=

# Any long random string — `openssl rand -hex 32`. Telegram echoes it back on
# every update, which is how the endpoint tells a genuine one from anybody who
# guessed the path.
TELEGRAM_WEBHOOK_SECRET=

# =============================================================================
# OPTIONAL — sensible defaults, change only if you need to
# =============================================================================

# --- server ---
PORT=8080
LOG_LEVEL=info                      # debug | info | warn | error
DATABASE_MAX_CONNECTIONS=10

# --- Mini App ---
# Origins allowed to call the API directly; the Vite dev server, mostly.
CORS_ORIGINS=http://localhost:5173
# How long a Mini App launch stays valid before the user must reopen the app.
TELEGRAM_INITDATA_TTL=24h

# --- defaults for trips created from the bot, which has no picker ---
DEFAULT_TIMEZONE=UTC                # any IANA zone, e.g. Europe/Warsaw
DEFAULT_CURRENCY=EUR                # EUR | USD | GBP | PLN | UAH | CZK

# --- background workers ---
SCHEDULER_INTERVAL=1m               # how often the reminder rules are re-evaluated
NOTIFY_INTERVAL=15s                 # how often the outbox is drained

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================

# Opens the Mini App in a desktop browser as this Telegram user. Requests then
# carry no signature, so the server refuses to start if this is set while
# APP_ENV is not development.
DEV_USER_TELEGRAM_ID=
