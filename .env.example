# Copy to .env and fill in. Every value here is also a plain environment
# variable, so a container platform can set them directly.

# ------------------------------------------------------------------- basics --
APP_ENV=development          # development | production
PORT=8080
LOG_LEVEL=info               # debug | info | warn | error

# ------------------------------------------------------------------ database --
# PostgreSQL in production:
#   DATABASE_URL=postgres://tripops:tripops@localhost:5432/tripops?sslmode=disable
# SQLite for local development and tests — no server needed:
DATABASE_URL=sqlite://tripops.db
DATABASE_MAX_CONNECTIONS=10

# ------------------------------------------------------------------ Telegram --
# From @BotFather. Without it the API still runs; the bot does not.
TELEGRAM_BOT_TOKEN=
# Used to build invite deep links (https://t.me/<username>?start=inv_…).
TELEGRAM_BOT_USERNAME=

# polling works anywhere; webhook needs a public HTTPS URL.
TELEGRAM_BOT_MODE=polling
TELEGRAM_WEBHOOK_URL=
# Any long random string; Telegram echoes it back so the endpoint can tell
# genuine updates from anyone who guessed the path.
TELEGRAM_WEBHOOK_SECRET=

# How long a Mini App launch stays valid.
TELEGRAM_INITDATA_TTL=24h

# ------------------------------------------------------------------ Mini App --
# Public HTTPS URL of the Mini App, set in @BotFather as well.
MINIAPP_URL=
# Origins allowed to call the API directly (the Vite dev server, mostly).
CORS_ORIGINS=http://localhost:5173

# Development only: browse the Mini App outside Telegram as this Telegram user.
# Requests then carry no signature, so the server refuses to honour it unless
# APP_ENV=development.
DEV_USER_TELEGRAM_ID=

# ------------------------------------------------------------------ defaults --
# Applied to trips created from the bot, which has no timezone picker.
DEFAULT_TIMEZONE=UTC
DEFAULT_CURRENCY=EUR

# ------------------------------------------------------------------- workers --
SCHEDULER_INTERVAL=1m        # how often the reminder rules are re-evaluated
NOTIFY_INTERVAL=15s          # how often the outbox is drained
